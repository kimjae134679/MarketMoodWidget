<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app"
        android:label="공포 &amp; 탐욕 지수"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1x1 / 2x1 fixed variants. No configuration screen. -->
        <receiver android:name=".FixedWidgetProviders$KospiMoodSmall" android:label="코스피 탐욕 1×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mood_small_info"/>
        </receiver>
        <receiver android:name=".FixedWidgetProviders$KospiMoodWide" android:label="코스피 탐욕 2×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mood_wide_info"/>
        </receiver>
        <receiver android:name=".FixedWidgetProviders$NasdaqMoodSmall" android:label="나스닥 탐욕 1×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mood_small_info"/>
        </receiver>
        <receiver android:name=".FixedWidgetProviders$NasdaqMoodWide" android:label="나스닥 탐욕 2×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mood_wide_info"/>
        </receiver>
        <receiver android:name=".FixedWidgetProviders$KospiChangeSmall" android:label="코스피 등락 1×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/change_small_info"/>
        </receiver>
        <receiver android:name=".FixedWidgetProviders$KospiChangeWide" android:label="코스피 등락 2×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/change_wide_info"/>
        </receiver>
        <receiver android:name=".FixedWidgetProviders$NasdaqChangeSmall" android:label="나스닥 등락 1×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/change_small_info"/>
        </receiver>
        <receiver android:name=".FixedWidgetProviders$NasdaqChangeWide" android:label="나스닥 등락 2×1" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="com.marketmood.widget.REFRESH"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/change_wide_info"/>
        </receiver>

        <!-- Hidden legacy v1.1 receiver is intentionally not registered anymore. -->
    </application>
</manifest>
